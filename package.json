{
  "name": "ble-light",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "微信小程序 BLE 直连控制 ESP32-C3 驱动的 WS2812B 灯带",
  "scripts": {
    "gen": "node scripts/gen-protocol.mjs",
    "gen:check": "node scripts/gen-protocol.mjs --check",
    "map": "node scripts/map.mjs",
    "map:check": "node scripts/map.mjs --strict",
    "test": "node scripts/test-firmware.mjs && node --test --test-concurrency=1 scripts/*.test.mjs && npm --prefix miniprogram test",
    "check": "npm run gen:check && npm run map:check",
    "sync": "npm run gen && npm run map",
    "panel": "npm --prefix panel run dev",
    "panel:build": "npm --prefix panel run build",
    "setup": "npm --prefix panel install",
    "test:firmware": "node scripts/test-firmware.mjs",
    "test:firmware:cov": "node scripts/test-firmware.mjs --cov",
    "build:firmware": "node scripts/build-firmware.mjs",
    "test:mp": "npm --prefix miniprogram test"
  },
  "dependencies": {
    "marked": "^18.1.3"
  }
}
