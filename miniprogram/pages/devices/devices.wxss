/* 设备列表页。所有尺寸走 app.wxss 的变量，颜色不写 hex。 */

.page {
  min-height: 100vh;
  padding: 0 var(--space-page) calc(160rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

/* 状态栏 */
.statusbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  color: var(--text-secondary);
}
.statusbar .t-caption { color: var(--text-secondary); }

/* 导航栏 */
.nav { position: relative; padding-bottom: 32rpx; }
.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.t-display { color: var(--text-primary); }

.plus-btn {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}
.plus-btn-on {
  background: var(--accent-wash);
  border: 2rpx solid var(--accent);
}
.plus-h, .plus-v { position: absolute; background: var(--accent); border-radius: 2rpx; }
.plus-h { left: 20rpx; top: 34rpx; width: 32rpx; height: 4rpx; }
.plus-v { left: 34rpx; top: 20rpx; width: 4rpx; height: 32rpx; }

/* 添加菜单 */
.add-menu {
  position: absolute;
  right: 0;
  top: 168rpx;
  width: 400rpx;
  height: 152rpx;
  border-radius: var(--radius-row);
  background: var(--surface);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.menu-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--surface-nested);
  flex: none;
}
.menu-icon .plus-h { left: 16rpx; top: 30rpx; width: 32rpx; height: 4rpx; }
.menu-icon .plus-v { left: 30rpx; top: 16rpx; width: 4rpx; height: 32rpx; }
.menu-text { display: flex; flex-direction: column; gap: 8rpx; margin-left: 24rpx; }
.menu-sub { color: var(--text-secondary); }
.menu-hit { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* 摘要 */
.summary { display: block; color: var(--text-secondary); margin-bottom: 24rpx; }

/* 双列网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.device-card {
  width: calc((100% - 24rpx) / 2);
  border-radius: var(--radius-card);
  background: var(--surface);
  overflow: hidden;
  box-sizing: border-box;
}

/* 封面 */
.cover {
  position: relative;
  height: 224rpx;
  background: var(--surface-nested);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-tag {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: var(--surface);
  color: var(--accent);
  display: flex;
  align-items: center;
}

/* 灯泡插画（内容，不是界面） */
.bulb { position: relative; width: 104rpx; height: 104rpx; }
.bulb-glass {
  position: absolute;
  left: 12rpx;
  top: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bulb);
}
.bulb-shine {
  position: absolute;
  left: 28rpx;
  top: 12rpx;
  width: 20rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--bulb-shine);
}
.bulb-base {
  position: absolute;
  left: 38rpx;
  top: 76rpx;
  width: 28rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: var(--bulb-base);
}

/* 卡片文字区 */
.card-name {
  display: block;
  margin: 24rpx 24rpx 0;
  color: var(--text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-foot {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 24rpx;
}
.card-meta { margin-left: 12rpx; color: var(--text-secondary); flex: 1; }
.card-switch { transform: scale(0.72); transform-origin: right center; }

/* 状态点 */
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex: none; }
.dot-ok { background: var(--ok); }
.dot-hot { background: var(--dot-active); }
.dot-grey { background: var(--text-tertiary); }
.dot-accent { background: var(--accent); }

/* 空态 */
.empty-card {
  margin-top: 16rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  padding: 64rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.empty-tile {
  width: 176rpx;
  height: 176rpx;
  border-radius: 40rpx;
  background: var(--surface-nested);
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-title { color: var(--text-primary); }
.empty-sub { color: var(--text-secondary); }

/* 底部导航 */
.tabbar {
  position: fixed;
  left: var(--space-page);
  right: var(--space-page);
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--surface);
  display: flex;
  align-items: center;
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.tab-text { color: var(--text-secondary); }
.tab-active { color: var(--text-body); }
