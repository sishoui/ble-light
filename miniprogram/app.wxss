/**
 * 设计变量。全项目唯一的颜色与字号来源。
 * 权威定义在 docs/design.md，这里只是它的可执行副本。
 * 改这里必须同步改文档，反之亦然。
 */

page {
  /* 深色为默认 */
  --bg: #000000;
  --surface-1: #1c1c1e;
  --surface-2: #2c2c2e;
  --surface-3: #3a3a3c;
  --label: rgba(255, 255, 255, 0.98);
  --label-2: rgba(235, 235, 245, 0.6);
  --label-3: rgba(235, 235, 245, 0.3);
  --separator: rgba(84, 84, 88, 0.6);

  --accent: #6b8cae;
  --accent-press: #5a7a9a;
  --accent-soft: #8fa9c4;
  --ok: #30d158;
  --warn: #ff9f0a;
  --err: #ff453a;

  --radius-card: 24rpx;
  --radius-control: 16rpx;
  --radius-button: 20rpx;
  --radius-pill: 999rpx;

  --space-page: 32rpx;
  --space-card: 32rpx;
  --space-gap: 24rpx;
  --space-block: 48rpx;
  --touch-min: 88rpx;

  --dur-fast: 200ms;
  --dur-page: 280ms;
  --ease: cubic-bezier(0.32, 0.72, 0, 1);

  background: var(--bg);
  color: var(--label);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

@media (prefers-color-scheme: light) {
  page {
    --bg: #f2f2f7;
    --surface-1: #ffffff;
    --surface-2: #f2f2f7;
    --surface-3: #e5e5ea;
    --label: #000000;
    --label-2: rgba(60, 60, 67, 0.6);
    --label-3: rgba(60, 60, 67, 0.3);
    --separator: rgba(60, 60, 67, 0.29);
  }
}

/* 手动覆盖优先于系统 */
.page.theme-dark {
  --bg: #000000;
  --surface-1: #1c1c1e;
  --surface-2: #2c2c2e;
  --surface-3: #3a3a3c;
  --label: rgba(255, 255, 255, 0.98);
  --label-2: rgba(235, 235, 245, 0.6);
  --label-3: rgba(235, 235, 245, 0.3);
  --separator: rgba(84, 84, 88, 0.6);
}

.page.theme-light {
  --bg: #f2f2f7;
  --surface-1: #ffffff;
  --surface-2: #f2f2f7;
  --surface-3: #e5e5ea;
  --label: #000000;
  --label-2: rgba(60, 60, 67, 0.6);
  --label-3: rgba(60, 60, 67, 0.3);
  --separator: rgba(60, 60, 67, 0.29);
}

/* 字号表：只允许 400 / 600 两个字重 */
.t-large-title { font-size: 68rpx; font-weight: 600; line-height: 1.2; }
.t-title       { font-size: 44rpx; font-weight: 600; line-height: 1.25; }
.t-subtitle    { font-size: 34rpx; font-weight: 600; line-height: 1.3; }
.t-body        { font-size: 30rpx; font-weight: 400; line-height: 1.5; }
.t-secondary   { font-size: 26rpx; font-weight: 400; line-height: 1.45; }
.t-caption     { font-size: 22rpx; font-weight: 400; line-height: 1.4; }

/* 数字等宽，避免亮度值变化时抖动 */
.tabular { font-variant-numeric: tabular-nums; }

@media (prefers-reduced-motion: reduce) {
  page { --dur-fast: 0ms; --dur-page: 0ms; }
}
