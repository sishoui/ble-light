/**
 * 设计变量。全项目唯一的颜色与字号来源。
 * 权威定义在 docs/design.md，这里只是它的可执行副本。
 * 改这里必须同步改文档，反之亦然。
 *
 * 风格：灰底柔光——浅灰画布、纯白卡、柔和投影、蓝色唯一强调。
 */

page {
  /* 表面 */
  --bg: #f2f4f7;
  --surface: #ffffff;
  --surface-nested: #edf0f4;
  --accent-wash: #ddebff;
  --hairline: #e4e8ee;

  /* 文字 */
  --text-primary: #17233d;
  --text-body: #33415e;
  --text-secondary: #5f6f87;
  --text-tertiary: #8d9cb2;

  /* 强调与语义 */
  --accent: #2f6bff;
  --accent-press: #2456d6;
  --ok: #3fbf6f;
  --dot-active: #e5484d;

  /* 封面插画（内容，不是界面；见 docs/design.md §11） */
  --bulb: #ffd98a;
  --bulb-shine: #fff3d0;
  --bulb-base: #b9c6d8;

  /* 圆角 */
  --radius-card: 48rpx;
  --radius-row: 32rpx;
  --radius-control: 24rpx;
  --radius-pill: 9999rpx;

  /* 间距（8pt 网格 = 16rpx 倍数） */
  --space-page: 32rpx;
  --space-card: 48rpx;
  --space-control: 32rpx;
  --space-gap: 16rpx;
  --space-block: 48rpx;
  --touch-min: 88rpx;

  /* 投影（三档，蓝灰调向下扩散） */
  --shadow-card: 0 16rpx 40rpx rgba(88, 100, 122, 0.14);
  --shadow-soft: 0 8rpx 24rpx rgba(88, 100, 122, 0.09);
  --shadow-knob: 0 4rpx 10rpx rgba(23, 55, 94, 0.18);

  /* 动效 */
  --dur-fast: 200ms;
  --dur-page: 280ms;
  --dur-wide: 320ms;
  --ease: cubic-bezier(0.32, 0.72, 0, 1);

  background: var(--bg);
  color: var(--text-body);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 32rpx;
  line-height: 1.5;
}

/* 字号表：只允许 400 / 500 / 600 */
.t-display  { font-size: 62rpx; font-weight: 600; line-height: 1.25; letter-spacing: -0.8rpx; }
.t-number   { font-size: 80rpx; font-weight: 600; line-height: 1.2;  letter-spacing: -1.6rpx; font-variant-numeric: tabular-nums; }
.t-heading  { font-size: 48rpx; font-weight: 600; line-height: 1.25; letter-spacing: -0.8rpx; }
.t-card     { font-size: 40rpx; font-weight: 600; line-height: 1.38; }
.t-body     { font-size: 32rpx; font-weight: 400; line-height: 1.5; }
.t-secondary{ font-size: 28rpx; font-weight: 400; line-height: 1.45; }
.t-label    { font-size: 24rpx; font-weight: 500; line-height: 1.2;  letter-spacing: 0.05em; }
.t-caption  { font-size: 20rpx; font-weight: 400; line-height: 1.4;  letter-spacing: 0.05em; }

/* 数字等宽 */
.tabular { font-variant-numeric: tabular-nums; }

/* 微标签：文字 + 前缀彩点 */
.tracked {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  line-height: 1.2;
}
.tracked::before {
  content: "";
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent);
}
.tracked.hot::before { background: var(--dot-active); }
.tracked.off::before { background: var(--text-tertiary); }

/* 表面 */
.surface        { background: var(--surface); }
.surface-nested { background: var(--surface-nested); }
.wash           { background: var(--accent-wash); }

/* 投影 */
.shadow-card { box-shadow: var(--shadow-card); }
.shadow-soft { box-shadow: var(--shadow-soft); }

/* 分隔线 */
.rule { height: 2rpx; background: var(--hairline); }
.rule-inset { margin-left: var(--space-page); }

/* 标签 chips */
.chip {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-wash);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  line-height: 1.2;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-soft);
}
.btn-primary { background: var(--accent); color: #ffffff; }
.btn-secondary { background: var(--surface); color: var(--text-body); }
.btn-text    { background: transparent; color: var(--accent); font-weight: 400; box-shadow: none; }
.btn-danger  { background: transparent; color: var(--dot-active); box-shadow: none; }

@media (prefers-reduced-motion: reduce) {
  page { --dur-fast: 0ms; --dur-page: 0ms; --dur-wide: 0ms; }
}
