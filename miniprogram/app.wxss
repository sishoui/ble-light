/**
 * 设计变量。全项目唯一的颜色与字号来源。
 * 权威定义在 docs/design.md，这里只是它的可执行副本。
 * 改这里必须同步改文档，反之亦然。
 *
 * 风格：暖调家居——米白画布、深棕主卡、焦糖强调、照片媒体卡。
 */

page {
  /* 表面 */
  --bg: #f7f3ec;
  --surface: #ffffff;
  --surface-warm: #efe8dd;
  --card-dark: #372e25;
  --hairline: #e9e2d6;

  /* 文字 */
  --text-primary: #322a20;
  --text-secondary: #8b7f6f;
  --text-tertiary: #b9ae9c;
  --on-dark: #ffffff;
  --on-dark-muted: rgba(255, 255, 255, 0.64);

  /* 强调与语义 */
  --accent: #d89a63;
  --accent-press: #c4854e;
  --accent-soft: #f4e6cf;
  --cool-soft: #e3edf7;
  --ok: #8bab8e;
  --error: #c05a3c;
  --scrim: rgba(20, 14, 8, 0.55);

  /* 圆角 */
  --radius-media: 40rpx;
  --radius-card: 32rpx;
  --radius-control: 24rpx;
  --radius-pill: 9999rpx;

  /* 间距（8pt 网格 = 16rpx 倍数） */
  --space-page: 32rpx;
  --space-card: 32rpx;
  --space-control: 24rpx;
  --space-gap: 16rpx;
  --space-block: 48rpx;
  --touch-min: 88rpx;

  /* 动效 */
  --dur-fast: 200ms;
  --dur-page: 280ms;
  --dur-wide: 320ms;
  --ease: cubic-bezier(0.32, 0.72, 0, 1);

  background: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

/* 字号表：只允许 400 / 600 两个字重 */
.t-title      { font-size: 44rpx; font-weight: 600; line-height: 1.3; }
.t-number     { font-size: 44rpx; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; }
.t-heading    { font-size: 34rpx; font-weight: 600; line-height: 1.4; }
.t-card       { font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.t-body       { font-size: 30rpx; font-weight: 400; line-height: 1.5; }
.t-secondary  { font-size: 26rpx; font-weight: 400; line-height: 1.45; }
.t-caption    { font-size: 22rpx; font-weight: 400; line-height: 1.4; }

/* 数字等宽，避免亮度值变化时抖动 */
.tabular { font-variant-numeric: tabular-nums; }

/* 表面 */
.surface       { background: var(--surface); }
.surface-warm  { background: var(--surface-warm); }
.card-dark     { background: var(--card-dark); color: var(--on-dark); }

/* 分隔线 */
.rule { height: 2rpx; background: var(--hairline); }
.rule-inset { margin-left: var(--space-page); }

/* 标签 chips */
.chip {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  color: var(--text-primary);
  font-size: 22rpx;
  line-height: 1.4;
}
.chip.cool { background: var(--cool-soft); }
.chip.on-photo { background: rgba(255, 255, 255, 0.85); color: var(--text-primary); }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 600;
}
.btn-primary { background: var(--card-dark); color: var(--on-dark); }
.btn-accent  { background: var(--accent); color: var(--on-dark); }
.btn-secondary { background: var(--surface-warm); color: var(--text-primary); }
.btn-text    { background: transparent; color: var(--text-secondary); font-weight: 400; }
.btn-danger  { background: transparent; color: var(--error); }

/* 照片媒体卡 */
.photo-card {
  position: relative;
  border-radius: var(--radius-media);
  overflow: hidden;
}
.photo-card .scrim {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 50%;
  background: linear-gradient(to bottom, transparent, var(--scrim));
}

@media (prefers-reduced-motion: reduce) {
  page { --dur-fast: 0ms; --dur-page: 0ms; --dur-wide: 0ms; }
}
