{
  "$comment": "唯一需要手写的面板输入。只写「生成器猜不出来的东西」：模块的一句话职责。文件清单、文档、测试、迭代全部由 scripts/map.mjs 扫描生成，不要写进这里。",
  "version": 1,
  "project": {
    "name": "ble-light",
    "tagline": "微信小程序 BLE 直连控制 ESP32-C3 驱动的 WS2812B 灯带",
    "repo": "sishoui/ble-light"
  },
  "layers": [
    {
      "id": "firmware",
      "name": "固件",
      "blurb": "ESP-IDF v6.1 + NimBLE，跑在 ESP32-C3FH4 上",
      "dirs": [
        "firmware"
      ]
    },
    {
      "id": "miniprogram",
      "name": "小程序",
      "blurb": "微信小程序原生 + TypeScript，手机侧全部逻辑",
      "dirs": [
        "miniprogram"
      ]
    },
    {
      "id": "docs",
      "name": "文档",
      "blurb": "每个事实只有一个家",
      "dirs": [
        "docs"
      ]
    },
    {
      "id": "tooling",
      "name": "工具",
      "blurb": "生成器、探针、压测、面板",
      "dirs": [
        "scripts",
        "tools",
        "panel"
      ]
    }
  ],
  "modules": [
    {
      "path": "firmware/main/protocol.c",
      "layer": "firmware",
      "seam": "protocol",
      "role": "信封解码、CRC16、ACK / Event / 各固定报告编码。纯函数。"
    },
    {
      "path": "firmware/main/command.c",
      "layer": "firmware",
      "seam": "reducer",
      "role": "命令 reducer：校验命令字 / 长度 / 取值，输出新状态、结果码与意图。"
    },
    {
      "path": "firmware/main/led_render.c",
      "layer": "firmware",
      "seam": "render",
      "role": "一份快照 + 布局 + 场景 + 播放头 → 一帧像素。整帧亮度与 gamma 只做一次。"
    },
    {
      "path": "firmware/main/effects.c",
      "layer": "firmware",
      "seam": "render",
      "role": "八种灯效的像素公式、层编解码、参数与形状校验、两层合成。"
    },
    {
      "path": "firmware/main/scene_compose.c",
      "layer": "firmware",
      "seam": "render",
      "role": "渲染唯一入口：按链合成，推进播放头，判断是否需要出新帧。"
    },
    {
      "path": "firmware/main/layout_store.c",
      "layer": "firmware",
      "seam": null,
      "role": "8 链 × 8 部位 × 8 段的布局表与相位，布局 blob 编解码。"
    },
    {
      "path": "firmware/main/scene_store.c",
      "layer": "firmware",
      "seam": null,
      "role": "三个场景表、每部位 8 步，场景 blob 编解码。"
    },
    {
      "path": "firmware/main/state_blob.c",
      "layer": "firmware",
      "seam": null,
      "role": "32 字节 State blob 编解码。解码失败整份拒绝。"
    },
    {
      "path": "firmware/main/save_scheduler.c",
      "layer": "firmware",
      "seam": null,
      "role": "按 NVS 键的防抖纯逻辑（500ms / 0ms / 2s），只存 blob 指针不拷贝。"
    },
    {
      "path": "firmware/main/ble_link.c",
      "layer": "firmware",
      "seam": null,
      "role": "NimBLE GATT server、广播、RX 喂分片、TX notify、多帧报告任务。"
    },
    {
      "path": "firmware/main/chunk_reasm.c",
      "layer": "firmware",
      "seam": "protocol",
      "role": "BLE 分片重组状态机：1 字节 ctrl、240B 上限、1000ms 超时。"
    },
    {
      "path": "firmware/main/led_engine.c",
      "layer": "firmware",
      "seam": null,
      "role": "共享状态唯一所有者、latest-wins 邮箱、渲染任务、布局与场景权威副本、64 个播放头。"
    },
    {
      "path": "firmware/main/led_strip_owner.c",
      "layer": "firmware",
      "seam": null,
      "role": "灯带句柄唯一所有者；运行时切 GPIO；推送像素。"
    },
    {
      "path": "firmware/main/strip_gpio.c",
      "layer": "firmware",
      "seam": null,
      "role": "链号 → GPIO 的固定表。纯函数，宿主机可测，不进 RMT 依赖。"
    },
    {
      "path": "firmware/main/gamma.c",
      "layer": "firmware",
      "seam": null,
      "role": "gamma 表、亮度乘算、色相丢失截断。"
    },
    {
      "path": "firmware/main/selftest.c",
      "layer": "firmware",
      "seam": null,
      "role": "红 / 绿 / 蓝 / 白各 500ms 的自检状态机。"
    },
    {
      "path": "miniprogram/utils/protocol",
      "layer": "miniprogram",
      "seam": "protocol",
      "role": "帧构造与解析、分片、命令构造器与解析器、常量与类型。"
    },
    {
      "path": "miniprogram/utils/ble",
      "layer": "miniprogram",
      "seam": "session",
      "role": "扫描、连接、MTU 协商、串行写、ACK 等待、多帧收集、错误分诊、日志。"
    },
    {
      "path": "miniprogram/utils/control/session.ts",
      "layer": "miniprogram",
      "seam": "session",
      "role": "页面唯一门面：连接、状态镜像、命令语义、节流。页面不直接碰传输层。"
    },
    {
      "path": "miniprogram/pages",
      "layer": "miniprogram",
      "seam": "page",
      "role": "页面：设备列表（tab）/ 设备详情 / 灯链详情 / 添加设备。页面只做视图与事件绑定。"
    },
    {
      "path": "miniprogram/app.wxss",
      "layer": "miniprogram",
      "seam": null,
      "role": "设计变量的可执行副本：颜色、圆角、间距、动效与字号表。权威定义在 docs/design.md。"
    },
    {
      "path": "miniprogram/components",
      "layer": "miniprogram",
      "seam": "page",
      "role": "自建导航栏与 tabBar（含状态栏高度与胶囊避让）。"
    },
    {
      "path": "scripts/map.mjs",
      "layer": "tooling",
      "seam": null,
      "role": "扫描仓库生成 docs/map.generated.json：文件、文档、测试、迭代、健康检查。"
    },
    {
      "path": "scripts/map.test.mjs",
      "layer": "tooling",
      "seam": "tooling",
      "role": "测生成器本身：扫描正确性、六类健康检查、协议向量与常量一致性。"
    },
    {
      "path": "scripts/gen-protocol.mjs",
      "layer": "tooling",
      "seam": "protocol",
      "role": "从 docs/protocol.json 生成 C 头、TS 常量、测试向量、文档表格段。"
    },
    {
      "path": "scripts/file-api.mjs",
      "layer": "tooling",
      "seam": null,
      "role": "面板的文件读取入口：白名单 + 路径归一化 + 二进制与大小拦截。"
    },
    {
      "path": "scripts/highlight.mjs",
      "layer": "tooling",
      "seam": null,
      "role": "单趟扫描的极简语法高亮，供面板的文件查看器使用。"
    },
    {
      "path": "scripts/markdown.mjs",
      "layer": "tooling",
      "seam": null,
      "role": "Markdown 预览：剥 frontmatter、丢原始 HTML、链接协议白名单、标题生成锚点。"
    },
    {
      "path": "scripts/tasks.mjs",
      "layer": "tooling",
      "seam": null,
      "role": "从 GitHub 拉任务图：父票、阻塞边、子项完成度与前沿判定。"
    },
    {
      "path": "docs/protocol.json",
      "layer": "docs",
      "seam": "protocol",
      "role": "协议的唯一真相：命令、报告、上限、层、状态、持久化。"
    },
    {
      "path": "panel",
      "layer": "tooling",
      "seam": null,
      "role": "Vue 3 项目管理面板，只读 map.generated.json。"
    },
    {
      "path": "firmware/main/device_core.c",
      "layer": "firmware",
      "seam": "reducer",
      "role": "设备内核：状态机 + 意图收集。把 reducer 的输出翻成副作用清单。"
    },
    {
      "path": "miniprogram/utils/control/view-model.ts",
      "layer": "miniprogram",
      "seam": "page",
      "role": "会话状态 → 页面 data 的纯映射。页面只调它。"
    },
    {
      "path": "miniprogram/utils/control/discover-unit.ts",
      "layer": "miniprogram",
      "seam": "page",
      "role": "设备列表页搜索下拉的视图模型与交互单元，纯函数。"
    },
    {
      "path": "miniprogram/tests/session/fake-transport.ts",
      "layer": "miniprogram",
      "seam": "session",
      "role": "假传输：记录设备收到了什么，可脚本化响应。测试只断言它的内容。"
    },
    {
      "path": "miniprogram/utils/control/device-list-unit.ts",
      "layer": "miniprogram",
      "seam": "page",
      "role": "设备列表视图模型：已保存设备 → 双列卡片（在线/开关/元信息）与摘要。"
    },
    {
      "path": "miniprogram/utils/control/device-detail-unit.ts",
      "layer": "miniprogram",
      "seam": "page",
      "role": "设备详情视图模型：状态 → 主卡、亮度百分比与灯链行。"
    },
    {
      "path": "miniprogram/utils/control/brightness-unit.ts",
      "layer": "miniprogram",
      "seam": "page",
      "role": "亮度百分比 ↔ 设备值换算。节流不在这里，归会话层。"
    },
    {
      "path": "miniprogram/utils/control/strip-detail-unit.ts",
      "layer": "miniprogram",
      "seam": "page",
      "role": "灯链详情视图模型：部位段 → 可读区间、未分配段与已划分计数。"
    },
    {
      "path": "miniprogram/utils/local",
      "layer": "miniprogram",
      "seam": null,
      "role": "本机数据：设备备注名与最近连接记录。只存人和设备的对应关系，不缓存灯光配置。"
    },
    {
      "path": "miniprogram/types",
      "layer": "miniprogram",
      "seam": null,
      "role": "微信小程序全局 API 的最小类型声明，只声明本项目用到的成员。"
    },
    {
      "path": "miniprogram/utils/ui",
      "layer": "miniprogram",
      "seam": null,
      "role": "原生控件颜色常量（switch / slider 只吃字面色值，读不到 CSS 变量）。"
    },
    {
      "path": "miniprogram/utils/ble/buffer.ts",
      "layer": "miniprogram",
      "seam": "session",
      "role": "Uint8Array ↔ ArrayBuffer 转换。微信 BLE 的 value 是 ArrayBuffer，带偏移的视图不能直接取 buffer。"
    }
  ],
  "rules": {
    "docsDir": "docs",
    "docsAllowed": [
      "docs/protocol.md",
      "docs/protocol.json",
      "docs/status.md",
      "docs/testing.md",
      "docs/acceptance.md",
      "docs/design.md",
      "docs/agents/issue-tracker.md",
      "docs/agents/domain.md"
    ],
    "docsAllowedPrefixes": [
      "docs/adr/",
      "docs/design/",
      "docs/design/v2/"
    ],
    "bannedDocPatterns": [
      "handoff",
      "pending-tasks",
      "protocol-v[0-9]",
      "spec-v[0-9]",
      "acceptance-v[0-9]",
      "-old",
      "-final"
    ],
    "maxStatusLines": 60,
    "testSeams": {
      "protocol": "协议编解码",
      "reducer": "命令 reducer",
      "render": "渲染合成",
      "session": "会话层",
      "page": "页面处理器"
    },
    "toolingTestSeam": "tooling",
    "toolingTestPaths": [
      "scripts/"
    ],
    "requireFrontmatter": true,
    "testSeamPaths": {
      "protocol": [
        "firmware/test/test_protocol.c",
        "miniprogram/tests/protocol/"
      ],
      "reducer": [
        "firmware/test/test_command.c",
        "firmware/test/test_device_core.c",
        "firmware/test/test_storage.c"
      ],
      "render": [
        "firmware/test/test_render.c",
        "firmware/test/test_strip_gpio.c"
      ],
      "session": [
        "miniprogram/tests/session/"
      ],
      "page": [
        "miniprogram/tests/page/"
      ]
    }
  }
}
